# sdk: this worker sends the transcript to DeepTrust itself (attach).
# cloud: the LiveKit project is connected in the DeepTrust dashboard, and this
#        worker only takes the nudges DeepTrust pushes into the room (listen).
DEEPTRUST_MODE=sdk

# DeepTrust. Only needed for DEEPTRUST_MODE=sdk.
DEEPTRUST_API_KEY=
# Only for a non-production workspace.
# DEEPTRUST_BASE_URL=https://app.dev.deeptrust.ai/api/v1

# LiveKit. https://cloud.livekit.io has a free tier, and LiveKit Inference
# covers the speech and the model with no other keys.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
